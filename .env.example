# Copy to .env.local for local runs. Never commit real values.
# With nothing set, the app runs locally with in-memory storage and prints emails to the console.

# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google Gemini (aistudio.google.com/apikey): prescription reading and medicine explanations.
GEMINI_API_KEY=
# Optional model override.
GEMINI_MODEL=gemini-3.8-flash

# Firebase service-account JSON for Firestore, on one line.
FIREBASE_SERVICE_ACCOUNT=

# Gmail account and app password used to send reminder emails.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Shared secret for the reminder job endpoint (/api/cron/reminders).
CRON_SECRET=
